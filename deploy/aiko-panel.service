[Unit]
Description=Aiko Panel (ERP + pricing + media studio) — one process, one worker
After=network-online.target tcp-mss-clamp.service
Wants=network-online.target

[Service]
User=aiko
Group=aiko
WorkingDirectory=/opt/aiko-panel
Environment=TZ=Asia/Tehran
ExecStart=/opt/aiko-panel/.venv/bin/python -m app serve
Restart=always
RestartSec=5
# Memory guard: if the app ever grows too big (a crawl, a large media file, ...), it is slowed and then killed
# and restarted on its own — instead of the whole server running out of RAM and freezing (SSH, Caddy, everything).
MemoryHigh=60%
MemoryMax=75%
# graceful stop: let uvicorn finish requests and close SQLite cleanly
TimeoutStopSec=20
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
