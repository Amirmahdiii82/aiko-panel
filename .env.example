# ===================== پنل آیکو — تنظیمات سرور =====================
# فقط تنظیمات زیرساختی اینجاست. کلید ووکامرس، توکن ربات، کلید OpenRouter و ... داخل خود برنامه تنظیم می‌شوند.

# بخش‌های فعال (به ترتیب منو). چت‌بات بعداً با افزودن "chat" فعال می‌شود.
MODULES=erp,pricing,media

# آدرس عمومی پنل (برای نمایش آدرس وب‌هوک ووکامرس)، مثلاً https://aiko.infinitcode.ir
PUBLIC_URL=
# پشت HTTPS (Caddy) حتماً 1 باشد تا کوکی ورود امن باشد
COOKIE_SECURE=0

# فقط روی 127.0.0.1 گوش بده؛ Caddy جلوی برنامه است
HOST=127.0.0.1
PORT=8020
TIMEZONE=Asia/Tehran
# DATA_DIR=./data
# SESSION_DAYS=30
# MAX_UPLOAD_MB=12
# LOG_LEVEL=INFO

# اولین اجرا روی پایگاه‌داده خالی: این دو نفر مدیر کل ساخته می‌شوند (بعد از ورود رمز را عوض کنید)
ADMIN_USERS=amir:امیر,tina:تینا
INITIAL_PASSWORD=change-me-please

# پشتیبان خودکار روزانه (ساعت تهران؛ خالی = خاموش) و چند روز نگه داشته شود
BACKUP_TIME=03:15
BACKUP_KEEP_DAYS=30
# BACKUP_DIR=./data/backups

# ===================== فروشگاه و حسابداری (erp) =====================
WOO_URL=https://aikocosmetics.ir

# ===================== قیمت رقبا (pricing) — همان متغیرهای برنامه قبلی =====================
OWN_SITE_URL=https://aikocosmetics.ir
OWN_SITE_NAME=آیکو کازمتیکس
# ساعت‌های بروزرسانی خودکار، مثلاً 09:00,21:00 (خالی = فقط دستی)
CRAWL_TIMES=
PRODUCT_LIMIT=0
MATCH_AUTO=0.80
MATCH_REVIEW=0.55
SITE_CONCURRENCY=2
REQUEST_DELAY=1.2
REQUEST_TIMEOUT=40
# HTTP_PROXY_URL=
# TOROB_SELLERS=0
# RUN_ON_STARTUP=0

# ===================== استودیو محتوا (media) =====================
# کلید و پروکسی را بهتر است از «تنظیمات استودیو» در خود پنل وارد کنید؛ این‌ها فقط مقدار پیش‌فرض‌اند.
# OPENROUTER_API_KEY=
# OPENROUTER_PROXY_URL=http://user:pass@host:port
